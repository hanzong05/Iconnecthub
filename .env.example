# Copy to .env.local and fill in. Never commit real values.
# All of these are read on the server only. Do NOT prefix them with NEXT_PUBLIC_.

# Secret used to sign this app's session cookie. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Firebase project used for sign-in (the same one the hub admin uses).
FIREBASE_API_KEY=
FIREBASE_DATABASE_URL=

# Worker that emails password reset links (called at POST {url}/send-reset).
PASSWORD_RESET_WORKER_URL=

# Optional: let people sign in with a Google or Apple account they have BOUND from the Account page (never to sign up).
# A provider with any value missing is switched off. Register this redirect address with each provider:
#   {NEXT_PUBLIC_SITE_URL}/api/auth/oauth/google/callback   and   {NEXT_PUBLIC_SITE_URL}/api/auth/oauth/apple/callback
# Also enable the same provider in Firebase Authentication, and set Firebase to "Create multiple accounts for each identity provider".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: Services ID, Team ID, Key ID, and the .p8 key with line breaks written as 
.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional. How long a sign-in lasts, in hours (default 8).
SESSION_HOURS=8

# Optional. Failed sign-ins allowed per email and IP per window (default 5), window in minutes (default 15).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Local testing only (ignored in production): point sign-in at a Firebase Auth emulator, e.g. 127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=

# Image uploads for events, the newsletter and hub logos (your ImgBB API key, kept on the server).
IMGBB_API_KEY=

# Optional: worker that deletes a user's login and changes their password (bluespot-delete-user).
DELETE_USER_WORKER_URL=

# Optional: worker that sends push + email to guests (the "Also notify guests" option appears only when set).
PUSH_WORKER_URL=

# Public address of this admin site, e.g. https://admin.yourdomain.com (no trailing slash).
# Used for the sitemap, robots.txt and the canonical link. It is read at BUILD time, so set it before building.
NEXT_PUBLIC_SITE_URL=
